{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "pragmatic-engine values",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "tenant", "console", "tls", "images"],
  "if": { "properties": { "hosted": { "const": true } }, "required": ["hosted"] },
  "then": {
    "description": "A Hosted engine (placed by the host agent, C5.1) is connected and its console relayed under hives.pragmatic-tech.ai.",
    "properties": {
      "level": { "const": "connected" },
      "console": { "properties": { "address": { "const": "relayed-hive-subdomain" } } }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    }
  },
  "properties": {
    "secrets": {
      "description": "No value of this chart is a secret: every engine secret is minted inside the cluster by the bootstrap Job.",
      "not": {}
    },
    "global": { "type": "object" },
    "level": { "type": "string", "enum": ["connected", "standalone"] },
    "hosted": { "type": "boolean" },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$" },
        "name": { "type": "string", "maxLength": 128 }
      }
    },
    "hive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^([a-z][a-z0-9-]{1,40}[a-z0-9])?$" },
        "name": { "type": "string", "maxLength": 128 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$" }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
        "address": { "type": "string", "enum": ["own-domain", "hive-subdomain", "relayed-hive-subdomain"] },
        "baseDomain": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dataSize": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["secret", "self-signed"] },
        "secretName": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": { "type": "string" },
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "className": { "type": "string" } }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" } }
    },
    "trustRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "publicKey"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "publicKey": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": { "type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?$" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channelUrl": { "type": "string", "pattern": "^https://" },
        "trustRoot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicKey"],
          "properties": { "publicKey": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" } }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "realmSecrets": {
      "description": "The realm secrets home (2.5): identifiers only, never a key (an empty value is unset; anything else must have the identifier's form, which no key, PEM or key file has). Workload identity supplies the credentials.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option": { "type": "string", "enum": ["custom", "gcp", "azure", "aws"] },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectId": { "type": "string", "pattern": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
            "workloadIdentityAudience": { "type": "string", "pattern": "^$|^//iam\\.googleapis\\.com/projects/[0-9]{1,20}/locations/global/workloadIdentityPools/[a-z0-9-]{4,32}/providers/[a-z0-9-]{4,32}$" },
            "serviceAccountEmail": { "type": "string", "pattern": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$" },
            "replicaLocation": { "type": "string", "pattern": "^$|^[a-z]+-[a-z]+[0-9]{1,2}$" }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenantId": { "type": "string", "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "clientId": { "type": "string", "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "vaultUrl": { "type": "string", "not": { "pattern": "--" }, "pattern": "^$|^https://[a-z][a-z0-9-]{1,22}[a-z0-9]\\.vault\\.(azure\\.net|azure\\.cn|usgovcloudapi\\.net)/?$" },
            "authorityHost": { "type": "string", "pattern": "^$|^https://login\\.(microsoftonline\\.com|chinacloudapi\\.cn|microsoftonline\\.us)/?$" }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": { "type": "string", "pattern": "^$|^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" },
            "roleArn": { "type": "string", "pattern": "^$|^arn:aws(-cn|-us-gov)?:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,512}$" },
            "sessionName": { "type": "string", "pattern": "^$|^[A-Za-z][A-Za-z0-9+=,.@-]{1,31}$", "not": { "pattern": "^(AKIA|ASIA)[A-Z0-9]{16}$" } }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console": { "$ref": "#/definitions/resources" },
        "idp": { "$ref": "#/definitions/resources" },
        "agent": { "$ref": "#/definitions/resources" },
        "postgres": { "$ref": "#/definitions/resources" },
        "job": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
